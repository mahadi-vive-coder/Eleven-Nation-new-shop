# =====================================================================
# ELEVEN NATION — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# Application Domain
VITE_APP_URL="https://elevennation.shop"

# ---------------------------------------------------------------------
# PUBLIC BROWSER CREDENTIALS (Vite Client Bundle)
# Safe to expose in frontend code. Protected by Row Level Security (RLS).
# ---------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ---------------------------------------------------------------------
# PRIVATE BACKEND CREDENTIALS (Server-Only / Edge Functions)
# CRITICAL: NEVER prefix with VITE_ or expose to browser client bundle!
# ---------------------------------------------------------------------
# Supabase Service Role Key (Admin / Worker operations only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-private-key"

# Steadfast Courier BD API Credentials (Edge Functions only)
STEADFAST_API_KEY="your-steadfast-api-key"
STEADFAST_SECRET_KEY="your-steadfast-secret-key"
STEADFAST_WEBHOOK_SECRET="your-steadfast-webhook-secret"

# Internal Security Secrets & Peppers (Edge Functions only)
RATE_LIMIT_PEPPER="minimum-32-character-high-entropy-random-secret"
CRON_SECRET="high-entropy-cron-secret-token"
